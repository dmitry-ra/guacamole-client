[Unit]
Description=Admitted personal Guacamole portal
Wants=network-online.target
Requires=guacamole-portal-network.service
After=network-online.target guacamole-portal-network.service
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 -B /opt/guacamole-portal/host.py run
ExecStopPost=/usr/bin/python3 -B /opt/guacamole-portal/host.py cutoff
Restart=on-failure
RestartSec=60
TimeoutStartSec=120
TimeoutStopSec=45
# Let the supervisor finish its in-flight engine call and perform owned cleanup.
# The stop timeout still escalates to SIGKILL for the entire service cgroup.
KillMode=mixed
UMask=0077

[Install]
WantedBy=multi-user.target
