# Derived from containers/common v0.57.4 pkg/apparmor/apparmor_linux_template.go.
# Preserve the default container restrictions. Only own-profile peer labels
# gain the exact crun stack variant required on Ubuntu Noble AppArmor4.
#include <tunables/global>

profile guacamole-portal flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,

  signal (receive) peer=unconfined,
  # Exact named OCI runtime peers (present in common0.66 default policy).
  signal (receive) peer=crun,
  signal (receive) peer=runc,
  signal (receive) peer=podman,
  signal (send,receive) peer=guacamole-portal,
  signal (send,receive) peer="guacamole-portal//&crun",
  signal (send,receive) peer="crun//&guacamole-portal",

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read) peer=guacamole-portal,
  ptrace (trace,read) peer="guacamole-portal//&crun",
  ptrace (trace,read) peer="crun//&guacamole-portal",
}
